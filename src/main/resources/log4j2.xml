<?xml version="1.0" encoding="UTF-8"?>
<!--
  SLF4J + Log4j2 configuration for the CST-323 cloud test application.
  Logs to the console (stdout) so that Azure, Heroku, AWS, and Google Cloud
  can all collect the log stream, and to a rolling file for local inspection.

  Line format (Activity 6): date/time stamp, level, thread, class name, then the message.
  The LoggingInterceptor writes the method name into every message as
  "[LAYER] Class.method() - ENTRY | EXIT | EXCEPTION - ...", so all layers share one
  naming convention. %M is not used: under AOP it would print the interceptor's method.

  Loggly (Activity 6, DevOps monitoring): an HTTP appender posts every log event to Loggly's
  HTTP/S event endpoint, tagged cst323_logfile_aws_upload. It is switched on only when the
  LOGGLY_TOKEN environment variable exists (EnvironmentArbiter), which is the case on AWS
  Elastic Beanstalk, where the token is an environment property. Local runs and the automated
  tests never call Loggly, and the token is never committed to Git. The HTTP appender sits
  behind an Async appender so a slow call to Loggly never delays a web request.
-->
<Configuration status="WARN">
    <Properties>
        <Property name="LOG_PATTERN">
            %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %c{1} - %msg%n
        </Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT" follow="true">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>

        <RollingFile name="RollingFile"
                     fileName="logs/cloud-test-app.log"
                     filePattern="logs/cloud-test-app-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="10 MB"/>
                <TimeBasedTriggeringPolicy/>
            </Policies>
            <DefaultRolloverStrategy max="5"/>
        </RollingFile>

        <EnvironmentArbiter propertyName="LOGGLY_TOKEN">
            <Http name="LogglyHttp"
                  url="https://logs-01.loggly.com/inputs/${env:LOGGLY_TOKEN}/tag/cst323_logfile_aws_upload/"
                  ignoreExceptions="true"
                  connectTimeoutMillis="3000"
                  readTimeoutMillis="5000">
                <PatternLayout pattern="${LOG_PATTERN}"/>
                <Property name="Content-Type" value="text/plain"/>
            </Http>
            <Async name="Loggly" bufferSize="1024">
                <AppenderRef ref="LogglyHttp"/>
            </Async>
        </EnvironmentArbiter>
    </Appenders>

    <Loggers>
        <Logger name="edu.gcu.cst323" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
            <EnvironmentArbiter propertyName="LOGGLY_TOKEN">
                <AppenderRef ref="Loggly"/>
            </EnvironmentArbiter>
        </Logger>
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
            <EnvironmentArbiter propertyName="LOGGLY_TOKEN">
                <AppenderRef ref="Loggly"/>
            </EnvironmentArbiter>
        </Root>
    </Loggers>
</Configuration>
